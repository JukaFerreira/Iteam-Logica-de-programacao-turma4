Algoritmo "Exercicio05"

//Exercício 5 – Positivo ou Negativo: Ler um número e
//mostrar se é positivo ou negativo

Var

   numero: inteiro

Inicio

   escreval("Digite um numero: ")
   leia(numero)

   se numero < 0 entao
      escreval("Numero negativo")
   senao
      escreval("Numero positivo")
   fimse

Fimalgoritmo