Algoritmo "Exercicio04"

//xercício 4 – Pode Dirigir: Ler a idade do usuário e
//informar se pode dirigir ou não

Var

idade: inteiro

Inicio

   escreval("Digite a sua idade: ")
   leia(idade)

   se idade < 18 entao
      escreval("Não pode dirigir, menor de idade!!!")
   senao
      escreval("Pode dirigir, maior de idade!!!")
   fimse

Fimalgoritmo